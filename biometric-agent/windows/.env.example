# Copy this file to ".env" and fill in the values.
# DATABASE_URL: same as Vercel production (Settings > Environment Variables).
# Paste WITHOUT the trailing \n that Vercel shows.
DATABASE_URL="postgresql://..."

# Dahua machine login (machine web UI user)
DAHUA_REG_USER=admin
DAHUA_REG_PASS=admin123

# Optional
# DAHUA_AUTO_REG_PORT=8099
# AGENT_STATUS_PORT=8098
# AGENT_BACKFILL_MAX_DAYS=31
